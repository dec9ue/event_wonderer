# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=site_patrol
DATABASE_URL=postgresql://app:app@localhost:5432/site_patrol?schema=public

# Backend
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# JWT secret (min 16 chars)
JWT_SECRET=change_me_to_a_long_secret

# Cookie settings
COOKIE_NAME=sid
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_BUCKET=attachments
MINIO_USE_SSL=false

# Presigned URL TTL (seconds)
PRESIGNED_TTL_SEC=60
# Max attachment size (bytes)
MAX_ATTACHMENT_BYTES=52428800

# Global rate limit
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW=1 minute
